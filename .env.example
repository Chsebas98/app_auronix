# Plantilla de variables de entorno — copiar a .env.dev / .env.prod con los valores reales.
# NUNCA commitear .env.dev ni .env.prod (ver .gitignore). Pedir los valores reales al dueño del
# proyecto; antes vivían hardcodeados en lib/app/environments/flavors/env_*_config.dart.
#
# Los valores de abajo son de mentira (API key de ejemplo, clave RSA descartable generada solo
# para que el formato sea valido) — sirven para que 'flutter test'/'flutter analyze' no se rompan
# en la CI (que nunca tiene los secretos reales), pero NO son los que usa la app real.

# URL base de la API del backend de Ando para este ambiente.
API_BASE_URL=http://127.0.0.1:8081/api

# API key de Google Maps/Places/Directions para este ambiente (restringirla por paquete/SHA en
# Google Cloud Console, nunca dejarla sin restricciones).
GOOGLE_MAPS_API_KEY=example-google-maps-api-key

# Clave simetrica/identificador usado por el cliente (ver uso real en el codigo antes de rotarla
# a ciegas — coordinar con el backend si el backend tambien la conoce).
TOKEN_KEY=example-token-key

# Clave publica RSA (PEM) codificada en base64 en una sola linea, usada para cifrar datos antes de
# enviarlos al backend. Generar la real con:
#   openssl rsa -in private_key.pem -pubout -out public_key.pem && base64 -i public_key.pem | tr -d '\n'
# La de abajo es una clave descartable generada solo para este ejemplo, no se usa en producción.
RSA_PUBLIC_KEY_
